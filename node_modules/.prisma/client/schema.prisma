generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  city        String?
  vehicleType String?
  eventType   String?
  message     String?
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

model Vehicle {
  id           String   @id @default(cuid())
  name         String
  category     String // e.g. Sedan, SUV, Tempo Traveller, Mini Bus, Luxury Bus
  seatCapacity Int
  imageUrl     String
  description  String
  priceFrom    Int? // null = "Contact for Quote"
  createdAt    DateTime @default(now())
}

model City {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  heroImage   String
  cardImage   String? // image shown on the cities grid card
  description String
  spots       FamousSpot[]
  createdAt   DateTime     @default(now())
}

model FamousSpot {
  id       String @id @default(cuid())
  name     String
  imageUrl String
  city     City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId   String
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  message      String
  rating       Int // 1-5
  imageUrl     String? // small avatar
  coverImage   String? // large trip/group photo shown at the top of the card
  role         String? // e.g. "CEO, PPM Logistics" or "Frequent Traveller"
  cityName     String?
  createdAt    DateTime @default(now())
  categorySlug String?
}

model PageContent {
  id                  String   @id @default(cuid())
  // "" = not specific. ("","") = global default, ("delhi","") = city,
  // ("","mini-bus") = vehicle, ("delhi","mini-bus") = both.
  citySlug            String   @default("")
  categorySlug        String   @default("")
  heroImage           String?
  heroHeading         String?
  heroSubheading      String?
  aboutVideoId        String?
  aboutVideoTitle     String?
  aboutLeft           String?
  aboutRight          String?
  aboutBottom         String[]
  fleetSubtitle       String?
  updatedAt           DateTime @updatedAt
  servicesTitleAccent String?
  servicesTitle       String?
  servicesSubheading  String?

  @@unique([citySlug, categorySlug])
}

model BlogPost {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String
  tag          String
  image        String
  citySlug     String   @default("")
  categorySlug String   @default("")
  publishedAt  DateTime @default(now())
}

model HeroSlide {
  id           String   @id @default(cuid())
  citySlug     String   @default("")
  categorySlug String   @default("")
  image        String
  heading      String
  subheading   String
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([citySlug, categorySlug])
}

model FleetItem {
  id               String   @id @default(cuid())
  citySlug         String   @default("")
  categorySlug     String   @default("")
  title            String
  subtitle         String
  description      String
  vehicleImage     String
  images           String[]
  amenities        Json     @default("[]")
  linkCategorySlug String   @default("") // category page the card's arrow opens
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([citySlug, categorySlug])
}

model ServiceCard {
  id           String   @id @default(cuid())
  citySlug     String   @default("")
  categorySlug String   @default("")
  occasion     String // tab name, e.g. "Wedding Travel"
  title        String
  description  String
  image        String
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([citySlug, categorySlug])
}
