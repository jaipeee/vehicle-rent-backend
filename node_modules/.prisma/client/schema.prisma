generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  city        String?
  vehicleType String?
  eventType   String?
  message     String?
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

model Vehicle {
  id           String   @id @default(cuid())
  name         String
  category     String // e.g. Sedan, SUV, Tempo Traveller, Mini Bus, Luxury Bus
  seatCapacity Int
  imageUrl     String
  description  String
  priceFrom    Int? // null = "Contact for Quote"
  createdAt    DateTime @default(now())
}

model City {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  heroImage   String
  description String
  spots       FamousSpot[]
  createdAt   DateTime     @default(now())
}

model FamousSpot {
  id       String @id @default(cuid())
  name     String
  imageUrl String
  city     City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId   String
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  message   String
  rating    Int // 1-5
  imageUrl  String?
  cityName  String?
  createdAt DateTime @default(now())
}
